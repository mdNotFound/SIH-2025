# SIH 2025 Deep-Sea eDNA Analysis Pipeline
# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env
.env.local

# Jupyter Notebooks
.ipynb_checkpoints

# PyTorch
*.pth
*.pt

# Data files (can be large)
data/raw_sequences/*.fastq
data/raw_sequences/*.fq
data/raw_sequences/*.fastq.gz
data/raw_sequences/*.fq.gz

# NCBI databases (very large)
data/ncbi_nt_euk/*.tar.gz
data/ncbi_nt_euk/*.nhr
data/ncbi_nt_euk/*.nin
data/ncbi_nt_euk/*.nsq
data/ncbi_nt_euk/*.xml
data/ncbi_nt_euk/temp_*

# Results (can be regenerated)
results/
logs/
*.log

# Models (can be large)
models/pretrained/
models/*.joblib
models/*.pkl
models/*.model

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Docker
.dockerignore

# Keep example data
!data/raw_sequences/test.fastq
!data/raw_sequences/README.md

# Keep important directories
!data/
!models/
!results/
!logs/

# But ignore their contents except for READMEs
data/*
!data/README.md
models/*
!models/README.md
results/*
!results/README.md
logs/*
!logs/README.md
